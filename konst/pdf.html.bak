    <main id="main">
      <div class="container">
        <div class="row section topspace">
          <div class="col-md-12">
            <p class="lead text-center text-muted">Uložit výkres jako PDF a DWG</p>
            <br>
            <b>Prostředí</b>: výkres<br>
            &nbsp;&nbsp; </div>
          <ul>
            <li>uložit pdf s možností nastavení </li>
            <li>dwg dle nastavení prohlížeče</li>
            <li>uloží s názvem jako číslo součásti z i-vlastností</li>
          </ul>
          <div class="col-md-12">
            <pre><span style="color: #808080; ">'pravidlo ukladani vykresu do pdf a dwg</span>

<span style="color: #808080; ">'Spustit externí pravidlo</span>
<span style="color: #808080; ">'iLogicVb.RunExternalRule("notes")</span>

<span style="color: #808080; ">'Slozka ulozeni</span>
<span style="color: #808080; ">'folderName = "C:\trans"</span>
 <span style="color: #800000; ">folderName</span> = <span style="color: #800080; ">ThisDoc</span>.<span
style="color: #800080; ">Path</span>

<span style="color: #808080; ">'nazev ukladani</span>
<span style="color: #800000; ">nazev</span>=<span style="color: #800080; ">iProperties</span>.<span
style="color: #800080; ">Value</span>(<span style="color: #008080; ">"Project"</span>, <span
style="color: #008080; ">"Part Number"</span>)
<span style="color: #808080; ">'nazev=iProperties.Value("Custom", "003_cislo_vykresu") &amp; "_" &amp; iProperties.Value("Project", "Part Number")</span>
<span style="color: #808080; ">'nazev=iProperties.Value("Custom", "001_Zeichnungsnummer")&amp;iProperties.Value("Custom", "009_Index")&amp; "(" &amp; iProperties.Value("Custom", "002_Benennung_de" ) &amp;")"</span>

<span style="color: #808080; ">'nazev ukladanych xls - uprava lomitek atd.</span>
<span style="color: #800000; ">txt1</span> = <span style="color: #800000; ">nazev</span>
<span style="color: #800000; ">txt2</span> = <span style="color: #800000; ">Replace</span>(<span
style="color: #800000; ">txt1</span>,<span style="color: #008080; ">"/"</span>,<span
style="color: #008080; ">"_"</span>)
<span style="color: #800000; ">txt3</span> = <span style="color: #800000; ">Replace</span>(<span
style="color: #800000; ">txt2</span>,<span style="color: #008080; ">"*"</span>,<span
style="color: #008080; ">"_"</span>)
<span style="color: #800000; ">edit_nazev</span> = <span style="color: #800000; ">txt3</span>


<span style="color: #800000; ">oPath</span> = <span style="color: #800080; ">ThisDoc</span>.<span
style="color: #800080; ">Path</span>
<span style="color: #800000; ">oFileName</span> = <span style="color: #800080; ">ThisDoc</span>.<span
style="color: #800000; ">FileName</span>(<span style="color: #FF0000; ">False</span>) <span
style="color: #808080; ">'without extension</span>
<span style="color: #800000; ">oRevNum</span> = <span style="color: #800080; ">iProperties</span>.<span
style="color: #800080; ">Value</span>(<span style="color: #008080; ">"Project"</span>, <span
style="color: #008080; ">"Revision Number"</span>)
<span style="color: #800000; ">oPDFAddIn</span> = <span style="color: #800080; ">ThisApplication</span>.<span
style="color: #800000; ">ApplicationAddIns</span>.<span style="color: #800000; ">ItemById</span> _
(<span style="color: #008080; ">"{0AC6FD96-2F4D-42CE-8BE0-8AEA580399E4}"</span>)
<span style="color: #800000; ">oDocument</span> = <span style="color: #800080; ">ThisApplication</span>.<span
style="color: #800000; ">ActiveDocument</span>
<span style="color: #800000; ">oContext</span> = <span style="color: #800080; ">ThisApplication</span>.<span
style="color: #800000; ">TransientObjects</span>.<span style="color: #800000; ">CreateTranslationContext</span>
<span style="color: #800000; ">oContext</span>.<span style="color: #800000; ">Type</span> = <span
style="color: #800000; ">IOMechanismEnum</span>.<span style="color: #800000; ">kFileBrowseIOMechanism</span>
<span style="color: #800000; ">oOptions</span> = <span style="color: #800080; ">ThisApplication</span>.<span
style="color: #800000; ">TransientObjects</span>.<span style="color: #800000; ">CreateNameValueMap</span>
<span style="color: #800000; ">oDataMedium</span> = <span style="color: #800080; ">ThisApplication</span>.<span
style="color: #800000; ">TransientObjects</span>.<span style="color: #800000; ">CreateDataMedium</span>
<span style="color: #808080; ">'If oPDFAddIn.HasSaveCopyAsOptions(oDataMedium, oContext, oOptions) Then</span>
<span style="color: #800000; ">oOptions</span>.<span style="color: #800000; ">Value</span>(<span
style="color: #008080; ">"All_Color_AS_Black"</span>) = 0<span style="color: #808080; ">' 1-vsechny barvy cerne</span>
<span style="color: #800000; ">oOptions</span>.<span style="color: #800000; ">Value</span>(<span
style="color: #008080; ">"Remove_Line_Weights"</span>) = 0
<span style="color: #800000; ">oOptions</span>.<span style="color: #800000; ">Value</span>(<span
style="color: #008080; ">"Vector_Resolution"</span>) = 400
<span style="color: #800000; ">oOptions</span>.<span style="color: #800000; ">Value</span>(<span
style="color: #008080; ">"Sheet_Range"</span>) = <span style="color: #800000; ">Inventor</span>.<span
style="color: #800000; ">PrintRangeEnum</span>.<span style="color: #800000; ">kPrintAllSheets</span>
<span style="color: #800000; ">oOptions</span>.<span style="color: #800000; ">Value</span>(<span
style="color: #008080; ">"Custom_Begin_Sheet"</span>) = 2
<span style="color: #800000; ">oOptions</span>.<span style="color: #800000; ">Value</span>(<span
style="color: #008080; ">"Custom_End_Sheet"</span>) = 4

<span style="color: #808080; ">'get PDF target folder path</span>
<span style="color: #800000; ">oFolder</span> = <span style="color: #800000; ">folderName</span>


<span style="color: #808080; ">'Check for the PDF folder and create it if it does not exist</span>
<span style="color: #FF0000; ">If</span> <span style="color: #FF0000; ">Not</span> <span
style="color: #800000; ">System</span>.<span style="color: #800000; ">IO</span>.<span
style="color: #800000; ">Directory</span>.<span style="color: #800000; ">Exists</span>(<span
style="color: #800000; ">oFolder</span>) <span style="color: #FF0000; ">Then</span>
<span style="color: #800000; ">System</span>.<span style="color: #800000; ">IO</span>.<span
style="color: #800000; ">Directory</span>.<span style="color: #800000; ">CreateDirectory</span>(<span
style="color: #800000; ">oFolder</span>)
<span style="color: #FF0000; ">End</span> <span style="color: #FF0000; ">If</span>

<span style="color: #808080; ">'Ulozit PDF</span>
<span style="color: #808080; ">'Set the PDF target file name</span>
<span style="color: #800000; ">oDataMedium</span>.<span style="color: #800000; ">FileName</span> = <span
style="color: #800000; ">oFolder</span> &amp; <span style="color: #008080; ">"\"</span> &amp; <span
style="color: #800000; ">edit_nazev</span> &amp; <span style="color: #008080; ">".pdf"</span>
<span style="color: #808080; ">'Publish document</span>
<span style="color: #800000; ">oPDFAddIn</span>.<span style="color: #800000; ">SaveCopyAs</span>(<span
style="color: #800000; ">oDocument</span>, <span style="color: #800000; ">oContext</span>, <span
style="color: #800000; ">oOptions</span>, <span style="color: #800000; ">oDataMedium</span>)

<span style="color: #808080; ">'Ulozit Dwg - podle nastaveni inventoru</span>
<span style="color: #808080; ">'Set the DWG target file name</span>
<span style="color: #800080; ">ThisDoc</span>.<span style="color: #800080; ">Document</span>.<span
style="color: #800000; ">SaveAs</span>(<span style="color: #800000; ">folderName</span> &amp; <span
style="color: #008080; ">"\"</span> &amp; <span style="color: #800000; ">edit_nazev</span> &amp; <span
style="color: #008080; ">".dwg"</span>, <span style="color: #FF0000; ">True</span>)</pre>
            <p class="lead text-center text-muted"> </p>
          </div>
