                href="vba.html"> <span class="img" style="height: 241px;"> <img
                    src="assets/images/VBA.png" alt="VBA" title="VBA"> <span class="cover"><span
                      class="more">See details →</span></span> </span>AUTOCAD -
                VBA </a><span class="details"></span> </div>
            <div class="col-xs-12 col-sm-6 col-md-4 col-lg-4"> <a class="thumbnail"
                href="tk.html"> <span class="img" style="height: 241px;"> <img
                    src="assets/images/TK.png" alt=""> <span class="cover"><span
