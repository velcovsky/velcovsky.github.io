            <div class="col-xs-12 col-sm-6 col-md-4 col-lg-4"> <a class="thumbnail"
                href="vba.html"> <span class="img" style="height: 241px;"> <img
                    src="assets/images/VBA.png" alt="VBA" title="VBA"> <span class="cover"><span
                      class="more">See details →</span></span> </span>AUTOCAD -
                VBA </a><span class="details"></span> </div>
            <div class="col-xs-12 col-sm-6 col-md-4 col-lg-4"> <a class="thumbnail"
                href="web%20TK/uvod%20do%20TK%20I.htm"> <span class="img" style="height: 241px;">
                  <img src="assets/images/TK.png" alt=""> <span class="cover"><span
                      class="more">See details →</span></span>&nbsp;</span><span
                  class="title">TECHNICKÉ KRESLEN<span style="color: #666666;">í</span></span></a><a
                href="http://www.gettemplate.com/downloads/initio.zip%20" class="btn btn-primary btn-lg"><span
                  style="font-family: &quot;Open sans&quot;,Helvetica,Arial,sans-serif;"></span></a></div>
          </div>
        </div>
