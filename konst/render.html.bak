    <main id="main">
      <div class="container">
        <div class="row section topspace">
          <div class="col-md-12">
            <p class="lead text-center text-muted">Render jpg</p>
            <br>
            <b>Prostředí</b>: výkres<br>
            &nbsp;&nbsp; </div>
          <ul>
            <li>definuje a nastaví tiskárnu</li>
            <li>vytiskne v příslušném formátu (PaperSizeEnum.kPaperSizeA4)</li>
          </ul>
          <div class="col-md-12">
            <pre><span style="color: #808080; "></span><span style="color: #FF0000; ">Sub</span> <span
style="color: #800000; ">Main</span>()
	<span style="color: #FF0000; ">Dim</span> <span style="color: #800000; ">oView</span> <span
style="color: #FF0000; ">As</span> <span style="color: #800000; ">Inventor</span>.<span
style="color: #800000; ">View</span>
	<span style="color: #800000; ">oView</span> = <span style="color: #800080; ">ThisApplication</span>.<span
style="color: #800000; ">ActiveView</span>
	
	<span style="color: #808080; ">'white background</span>
<span style="color: #808080; ">'ThisApplication.ColorSchemes.Item("Prezentace").Activate</span>
<span style="color: #800080; ">ThisApplication</span>.<span style="color: #800000; ">ColorSchemes</span>.<span
style="color: #800000; ">BackgroundType</span> = 52737
<span style="color: #808080; ">'ThisApplication.ColorSchemes.BackgroundType = 52738</span>

<span style="color: #808080; ">'Slozka ulozeni</span>
<span style="color: #808080; ">'folderName = "C:\trans"</span>
<span style="color: #800000; ">folderName</span> = <span style="color: #800080; ">ThisDoc</span>.<span
style="color: #800080; ">Path</span>

<span style="color: #808080; ">'cas</span>
<span style="color: #800080; ">iProperties</span>.<span style="color: #800080; ">Value</span>(<span
style="color: #008080; ">"Custom"</span>, <span style="color: #008080; ">"Time Saved"</span>) = <span
style="color: #800000; ">Now</span>.<span style="color: #800000; ">ToString</span>(<span
style="color: #008080; ">"HH:mm:ss"</span>)

<span style="color: #808080; ">'nazev ukladani</span>
<span style="color: #800000; ">nazev</span>= <span style="color: #800080; ">iProperties</span>.<span
style="color: #800080; ">Value</span>(<span style="color: #008080; ">"Project"</span>, <span
style="color: #008080; ">"Part Number"</span>)&amp;<span style="color: #008080; ">"-"</span>&amp; <span
style="color: #800080; ">iProperties</span>.<span style="color: #800080; ">Value</span>(<span
style="color: #008080; ">"Project"</span>, <span style="color: #008080; ">"Description"</span>) &amp; <span
style="color: #008080; ">"("</span> &amp; <span style="color: #800080; ">iProperties</span>.<span
style="color: #800080; ">Value</span>(<span style="color: #008080; ">"Custom"</span>, <span
style="color: #008080; ">"Time Saved"</span>) &amp; <span style="color: #008080; ">")"</span>


<span style="color: #808080; ">'nazev ukladanych xls - uprava lomitek atd.</span>
<span style="color: #800000; ">txt1</span> = <span style="color: #800000; ">nazev</span>
<span style="color: #800000; ">txt2</span> = <span style="color: #800000; ">Replace</span>(<span
style="color: #800000; ">txt1</span>,<span style="color: #008080; ">"/"</span>,<span
style="color: #008080; ">"_"</span>)
<span style="color: #800000; ">txt3</span> = <span style="color: #800000; ">Replace</span>(<span
style="color: #800000; ">txt2</span>,<span style="color: #008080; ">":"</span>,<span
style="color: #008080; ">"_"</span>)
<span style="color: #800000; ">edit_nazev</span> = <span style="color: #800000; ">txt3</span>
	
	<span style="color: #800000; ">oView</span>.<span style="color: #800000; ">DisplayMode</span> = <span
style="color: #800000; ">DisplayModeEnum</span>.<span style="color: #800000; ">kRealisticRendering</span>
	
	<span style="color: #808080; ">' start ray tracing</span>
	<span style="color: #800000; ">oView</span>.<span style="color: #800000; ">RayTracing</span>=  <span
style="color: #FF0000; ">True</span> 
	<span style="color: #800000; ">oView</span>.<span style="color: #800000; ">RayTracingQuality</span> = <span
style="color: #800000; ">RayTracingQualityEnum</span>.<span style="color: #800000; ">kHighRayTracingQuality</span>
	
	<span style="color: #FF0000; ">Dim</span> <span style="color: #800000; ">bStop</span> <span
style="color: #FF0000; ">As</span> <span style="color: #FF0000; ">Boolean</span> 
	
	<span style="color: #FF0000; ">Do</span> 
		<span style="color: #800080; ">ThisApplication</span>.<span style="color: #800000; ">UserInterfaceManager</span>.<span
style="color: #800000; ">DoEvents</span>
		
		<span style="color: #FF0000; ">If</span> (<span style="color: #800000; ">oView</span>.<span
style="color: #800000; ">RayTracingProgress</span> = 1) <span style="color: #FF0000; ">Then</span>
			<span style="color: #800000; ">bStop</span> = <span style="color: #FF0000; ">True</span>
			<span style="color: #800000; ">oView</span>.<span style="color: #800000; ">SaveAsBitmapWithRayTracing</span> (<span
style="color: #800000; ">folderName</span> &amp; <span style="color: #008080; ">"\"</span> &amp; <span
style="color: #800000; ">edit_nazev</span> &amp; <span style="color: #008080; ">".jpg"</span>)
		<span style="color: #FF0000; ">End</span> <span style="color: #FF0000; ">If</span>
		
		<span style="color: #FF0000; ">If</span> (<span style="color: #800000; ">oView</span>.<span
style="color: #800000; ">RayTracing</span> = <span style="color: #FF0000; ">False</span>) <span
style="color: #FF0000; ">Then</span>
				<span style="color: #800000; ">bStop</span> = <span style="color: #FF0000; ">True</span> 
		<span style="color: #FF0000; ">End</span> <span style="color: #FF0000; ">If</span>
	<span style="color: #FF0000; ">Loop</span> <span style="color: #FF0000; ">Until</span> (<span
style="color: #800000; ">bStop</span>)
	
	<span style="color: #808080; ">' turn off ray tracing</span>
	<span style="color: #800000; ">oView</span>.<span style="color: #800000; ">RayTracing</span> = <span
style="color: #FF0000; ">False</span> 
	
		<span style="color: #808080; ">'gradient background</span>
<span style="color: #808080; ">'ThisApplication.ColorSchemes.Item("Prezentace").Activate</span>
<span style="color: #808080; ">'ThisApplication.ColorSchemes.BackgroundType = 52737</span>
<span style="color: #800080; ">ThisApplication</span>.<span style="color: #800000; ">ColorSchemes</span>.<span
style="color: #800000; ">BackgroundType</span> = 52738
<span style="color: #FF0000; ">End</span> <span style="color: #FF0000; ">Sub</span><span
style="color: #FF0000; "></span><span style="color: #800000; "></span></pre>
            <p class="lead text-center text-muted"> </p>
          </div>
